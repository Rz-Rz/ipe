{
  "name": "@ipe/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The desktop application of IPE: an Electron shell hosting the kernel, and a React interface reaching it through one channel.",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "pnpm build:renderer && pnpm build:main",
    "dev": "vite",
    "bridge": "node scripts/bridge.mjs",
    "start": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@ipe/adapters-node": "workspace:*",
    "@ipe/kernel": "workspace:*",
    "@replit/codemirror-vim": "^6.2.1",
    "codemirror": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "vite": "^5.4.11"
  }
}
